# syntax=docker/dockerfile:1
FROM rust:1.99.0-bookworm AS engine
WORKDIR /engine
COPY --from=engine_source . ./
RUN cargo build --release --locked --jobs 2
FROM api_runtime
USER root
COPY --from=engine /engine/target/release/inkspect-engine /usr/local/bin/inkspect-engine
RUN mkdir -p /state && chown node:node /state
USER node
CMD ["node","dist/engine-worker.mjs"]
