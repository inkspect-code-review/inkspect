ARG INKSPECT_API_IMAGE=inkspect-api:0.1.0
FROM rust:1.94.1-bookworm AS engine
WORKDIR /engine
COPY engine ./
RUN cargo build --release --locked
FROM ${INKSPECT_API_IMAGE}
USER root
COPY --from=engine /engine/target/release/inkspect-engine /usr/local/bin/inkspect-engine
RUN mkdir -p /state && chown node:node /state
USER node
CMD ["node","dist/engine-worker.mjs"]
