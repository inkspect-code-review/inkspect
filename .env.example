# Public HTTPS origin. Configure your reverse proxy separately.
BETTER_AUTH_URL=https://review.example.com
HTTP_PORT=3002

# The setup container generates these; keep them unchanged across restarts.
# POSTGRES_PASSWORD must be URL-safe (the generated value is hexadecimal).
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
INKSPECT_ENGINE_SECRET=

# Start review workers as well as the dashboard. Leave empty for dashboard only.
COMPOSE_PROFILES=reviews

# Sign in with GitHub OAuth, or configure SMTP magic links below.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub App for repository access and reviews.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Only needed when this App differs from the sign-in OAuth application.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Put the App private key in config/github-app.pem.
# Configure the generated config/github-webhook-secret in your GitHub App.

# Email sign-in, invitations and other account emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Pubb realtime: required for live UI updates. Use one application's credentials.
# Set the public key BEFORE building; rebuild web if it changes.
PUBB_APP_ID=
NEXT_PUBLIC_PUBB_APP_KEY=
# Server runtime only; never put the secret in a NEXT_PUBLIC_ variable.
PUBB_APP_SECRET=

# Model credentials. Use your runtime's AWS identity if configured, or fill these.
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_BEARER_TOKEN_BEDROCK=
INKSPECT_DEFAULT_CHAT_MODEL=
# Optional chat pricing; review model prices/budget belong in config/host.json.
INKSPECT_AI_PRICING_MODEL=
INKSPECT_AI_PRICING_REGION=
INKSPECT_AI_INPUT_NANO_USD=
INKSPECT_AI_OUTPUT_NANO_USD=

# Select inkspect to route ALL instance AI operations through Inkspect.
# Create the key in the Cloud workspace. Enter it locally; never share it in chat.
INKSPECT_AI_PROVIDER=bedrock
INKSPECT_API_KEY=
